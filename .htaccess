<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /baby/

  # If requested path directly exists in dist/ (e.g. assets, logo.png)
  RewriteCond %{DOCUMENT_ROOT}/baby/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Otherwise serve the built SPA entry point
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>
